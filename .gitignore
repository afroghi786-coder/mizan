# ═══════════════════════════════════════════
#  .gitignore — نسخه صحیح
#  فقط پوشه‌های ریشه را ignore می‌کند
# ═══════════════════════════════════════════

# وابستگی‌ها (فقط ریشه)
/node_modules/

# Expo
.expo/
/web-build/

# بکاپ‌ها (فقط ریشه)
/backup-*/

# اسکریپت‌های dev (فقط ریشه)
/*.cjs

# لاگ‌ها
*.log
/check-errors.txt
/app-structure.json

# Env
.env
.env.local

# OS
.DS_Store
Thumbs.db

# Android build (اما نه سورس)
android/app/build/
android/build/
android/.gradle/
android/.idea/

# iOS build
ios/build/
ios/Pods/

# نکته: docs/assets/node_modules/ را ignore نمی‌کنیم
# چون فونت‌های Google داخلش است
.npmrc
/dist
/err.txt
/out.txt
# 📦 Vosk Models (downloaded by workflow)
assets/model-fa-fa/
assets/model-en-us/
assets/model-ar-ar/
assets/model-ps-ps/
assets/models-cache/
# 🔧 Android prebuild (workflow regenerates)
android/app/src/main/assets/model-fa-fa/
android/app/src/main/assets/model-en-us/
# ═══════════════════════════════════════════
#  Audit / backups / temp dumps (new)
# ═══════════════════════════════════════════
/audit-*.txt
/assistant-audit-*/
/whole-app-audit-*/
/backup-*/
/dist.zip
/local-check-result.txt
/comparison-report.txt
/app-imports.txt
/edit-form-code.txt
/ledger-modal-code.txt
/ledger-screen-code.txt
/settings-section.txt
/settings-sheets-full.txt

# ═══════════════════════════════════════════
#  Junk files from shell redirection
#  نکته: ! ابتدای نام در gitignore معنی negation دارد
#  پس با \! escape شده
# ═══════════════════════════════════════════
/\!(x
/\!deletedInvs.has(String(g.invoice
/(f.endsWith('.ts')
/String(a.code
/k.includes('product'))
/lib.getBanks()))
/lib.getParties()))
/lib.getPartners()))
/lib.getShippings()))
/null)
/p.invoice_number
/s
/s.invoice_number
/table.startsWith(p))
/x.id
/x.local_id
/{const
/npx
